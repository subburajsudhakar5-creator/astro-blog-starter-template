---
import { hotel, phoneLink } from "../data/hotel";
const phone = phoneLink();
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-brand">{hotel.name}</div>
      <p>{hotel.tagline}</p>
      <span class="footer-place">{hotel.town}, {hotel.state}</span>
    </div>
    <div>
      <h3>Explore</h3>
      <a href="/about">About us</a><a href="/rooms">Rooms & tariffs</a><a href="/facilities">Facilities</a><a href="/gallery">Gallery</a>
    </div>
    <div>
      <h3>Contact</h3>
      <span>{hotel.fullAddress || "Hotel address to be added"}</span>
      {phone ? <a href={phone}>{hotel.phoneDisplay || "Call the hotel"}</a> : <span>Phone number to be added</span>}
      <a href={`tel:+${hotel.alternatePhoneE164}`}>{hotel.alternatePhoneDisplay}</a>
      <a href={hotel.mapDirectionsUrl} target="_blank" rel="noopener noreferrer">Google Maps location</a>
    </div>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} {hotel.name}</span><span>Website information subject to confirmation by the hotel.</span></div>
</footer>
<style>
  .footer { background:#382820; color:#f8eee2; padding:52px 0 20px; }
  .footer-grid { display:grid; grid-template-columns:2fr 1fr 1.4fr; gap:38px; }
  .footer-brand { font:500 1.55rem Georgia,serif; }
  .footer p,.footer-place,.footer span { color:#d4c3b2; font-size:.88rem; line-height:1.7; }
  .footer h3 { margin:0 0 15px; color:#d5ad7b; font:500 1.1rem Georgia,serif; }
  .footer a { display:block; width:fit-content; margin:9px 0; color:#f8eee2; font-size:.88rem; }
  .footer a:hover { color:#e0b77f; }
  .footer-bottom { border-top:1px solid #5c463a; margin-top:38px; padding-top:17px; display:flex; justify-content:space-between; gap:20px; font-size:.75rem; color:#c4b2a2; }
  @media(max-width:650px) { .footer-grid { grid-template-columns:1fr 1fr; } .footer-grid>div:first-child { grid-column:1/-1; } .footer-bottom { flex-direction:column; gap:5px; } }
</style>