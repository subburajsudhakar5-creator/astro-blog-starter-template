---
import { hotel, phoneLink } from "../data/hotel";
const phone = phoneLink();
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/rooms", label: "Rooms" },
  { href: "/facilities", label: "Facilities" },
  { href: "/gallery", label: "Gallery" },
  { href: "/contact", label: "Contact" },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${hotel.name} home`}>
      <img class="brand-mark" src="/images/hotel-logo.webp" alt="Sree Venkatesh Residency logo" />
      <span><strong>{hotel.name}</strong><small>{hotel.town} · Tamil Nadu</small></span>
    </a>
    <nav aria-label="Main navigation" class="desktop-nav">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      {phone && <a class="header-phone" href={phone} aria-label="Call Sree Venkatesh Residency at 9865434732">☎ Call 9865434732</a>}
      <a class="btn btn-primary header-book" href={phone || "/contact"} aria-label="Call now on 9865434732">☎ Call Now</a>
      <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu">☰</button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  toggle?.addEventListener("click", () => {
    if (!menu) return;
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    menu.hidden = isOpen;
  });
</script>
<style>
  .site-header { background: #fffdf9; border-bottom: 1px solid var(--line); position: relative; z-index: 10; }
  .header-inner { min-height: 82px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .brand { display:flex; align-items:center; gap:11px; min-width:235px; }
  .brand-mark { width:48px; height:48px; border:1px solid var(--gold); object-fit:cover; border-radius:50%; background:#111; }
  .brand strong { display:block; color:var(--maroon-dark); font:600 1rem Georgia,serif; }
  .brand small { display:block; margin-top:4px; color:var(--muted); font-size:.66rem; letter-spacing:.13em; text-transform:uppercase; }
  .desktop-nav { display:flex; align-items:center; gap:21px; }
  .desktop-nav a,.header-phone { color:#5f5046; font-size:.82rem; font-weight:650; }
  .desktop-nav a:hover,.header-phone:hover { color:var(--maroon); }
  .header-actions { display:flex; align-items:center; gap:13px; }
  .header-book { min-height:42px; padding:.65rem .95rem; font-size:.8rem; }
  .menu-toggle { display:none; background:none; border:0; color:var(--maroon); font-size:1.5rem; cursor:pointer; }
  .mobile-nav { padding:8px 20px 18px; background:#fffdf9; border-top:1px solid var(--line); }
  .mobile-nav a { display:block; padding:11px 0; color:var(--ink); border-bottom:1px solid var(--line); }
  @media(max-width:900px) { .desktop-nav { display:none; } .menu-toggle { display:block; } }
  @media(max-width:520px) { .header-inner { min-height:72px; } .header-phone { display:none; } .brand { min-width:0; } .brand strong { font-size:.87rem; } .header-book { display:inline-flex; font-size:.76rem; padding:.6rem .75rem; } }
</style>