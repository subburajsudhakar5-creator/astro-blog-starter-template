---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { hotel, phoneLink } from "../data/hotel";
const phone = phoneLink();
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero">
      <div class="hero-image">
        <div class="hero-overlay"></div>
        <div class="container hero-content">
          <span class="eyebrow">WELCOME TO {hotel.town.toUpperCase()}</span>
          <h1 class="display">A comfortable stay.<br /><em>A warm welcome.</em></h1>
          <p>{hotel.name} offers a welcoming place to stay in {hotel.town}, Tamil Nadu. Explore our room options and contact us directly for availability and tariffs.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={phone || "/contact"}>Call for room enquiry</a>
            {phone && <a class="btn btn-light" href={phone}>Call the hotel</a>}
          </div>
        </div>
        <span class="image-caption">Sree Venkatesh Residency · Ettayapuram</span>
      </div>
    </section>

    <section class="intro section">
      <div class="container intro-grid">
        <div>
          <span class="eyebrow">SREE VENKATESH RESIDENCY · ETTAYAPURAM</span>
          <h2 class="display">Simple comforts,<br />thoughtful hospitality.</h2>
        </div>
        <p>Whether you are visiting Ettayapuram for work, family or travel, find a room that suits your stay. Speak directly with our team for current room availability, tariffs and information.</p>
      </div>
    </section>

    <section class="rooms section">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">STAY WITH US</span>
          <h2>Our rooms</h2>
          <p>Choose from our two room categories. Displayed tariffs exclude taxes. Call to confirm the final total and availability.</p>
        </div>
        <div class="room-grid">
          {hotel.rooms.map((room) => (
            <article class="room-card">
              <img src={room.image} alt={room.slug === "deluxe-ac-double" ? "Deluxe AC Double room at Sree Venkatesh Residency" : "Photo of Standard Single Non AC room to be added"} loading="lazy" />
              <div class="room-body">
                <span class="eyebrow">ROOM CATEGORY</span>
                <h3>{room.name}</h3>
                <p>{room.shortDescription}</p>
                <div class="room-bottom">
                  <span>{room.tariff || "Tariff on enquiry"}</span>
                  <a href={phone || "/contact"}>Enquire →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="stay-timings" aria-label="Check-in and check-out policy">
          <div><span>CHECK-IN</span><strong>{hotel.checkInTime}</strong></div>
          <div><span>CHECK-OUT</span><strong>{hotel.checkOutTime}</strong></div>
          <p>Room tariffs are per night; applicable taxes are additional. Check-out is at 11:00 AM the following day.</p>
        </div>
      </div>
    </section>

    <section class="welcome section">
      <div class="container welcome-grid">
        <div class="welcome-photo"><img src="/images/hotel-entrance.webp" alt="Entrance of Sree Venkatesh Residency, Ettayapuram" loading="lazy" /></div>
        <div class="welcome-copy">
          <span class="eyebrow">YOUR STAY IN ETTAYAPURAM</span>
          <h2 class="display">A convenient place to pause, rest and refresh.</h2>
          <p>We look forward to welcoming you to Sree Venkatesh Residency. Get in touch with us to discuss your stay and room requirements.</p>
          <a class="text-link" href="/about">Discover our residency <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="section property-gallery">
      <div class="container">
        <div class="section-heading"><span class="eyebrow">A LOOK AROUND</span><h2>Our residency</h2><p>Photos of our hotel, guest rooms and common corridors.</p></div>
        <div class="property-photos">
          <img src="/images/deluxe-ac-room-2.webp" alt="Deluxe AC room with air conditioner and wardrobe" loading="lazy" />
          <img src="/images/deluxe-ac-room-3.webp" alt="Deluxe AC room with double bed and wooden furniture" loading="lazy" />
          <img src="/images/interior-corridor.webp" alt="Interior guest room corridor" loading="lazy" />
        </div>
        <div class="gallery-link"><a class="btn btn-outline" href="/gallery">View photo gallery</a></div>
      </div>
    </section>
    <section class="cta section">
      <div class="container cta-inner">
        <span class="eyebrow">PLAN YOUR STAY</span>
        <h2 class="display">Need a room in Ettayapuram?</h2>
        <p>Contact Sree Venkatesh Residency directly for room availability and tariff details.</p>
        <a class="btn btn-primary" href={phone || "/contact"}>Call for availability</a>
      </div>
    </section>
  </main>
  <Footer />

</BaseLayout>
<style>
  .hero-image { min-height:570px; position:relative; display:flex; align-items:center; background:linear-gradient(90deg,#21160fd9 0%,#21160f88 48%,#21160f12 100%),url('/images/hotel-exterior-side.webp') center/cover; }
  .hero-overlay { position:absolute; inset:0; background:linear-gradient(0deg,#21160f22,transparent 45%); }
  .hero-content { position:relative; z-index:1; padding-top:80px; padding-bottom:85px; color:white; }
  .hero-content .eyebrow { color:#e6c18f; }
  .hero h1 { max-width:720px; margin:20px 0; font-size:clamp(3rem,7vw,5.5rem); font-weight:500; }
  .hero h1 em { color:#e8c18d; font-weight:400; }
  .hero-content p { max-width:570px; color:#f2e7db; line-height:1.8; font-size:1.03rem; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; }
  .btn-light { color:#fff; border:1px solid #ffffffa8; background:#ffffff18; }
  .image-caption { position:absolute; bottom:13px; right:20px; color:#ffffffb8; font-size:.68rem; }
  .intro-grid { display:grid; grid-template-columns:1.1fr .9fr; align-items:center; gap:70px; }
  .intro h2,.welcome h2 { margin:15px 0 0; font-size:clamp(2.2rem,4.4vw,3.6rem); color:var(--maroon-dark); }
  .intro-grid>p,.welcome-copy p { color:var(--muted); line-height:1.9; font-size:1rem; }
  .rooms { background:var(--cream); }
  .room-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:25px; max-width:900px; margin:auto; }
  .room-card { background:white; border:1px solid var(--line); }
  .room-card img { width:100%; aspect-ratio:16/10; object-fit:cover; }
  .room-body { padding:24px; }
  .room-body h3 { margin:10px 0; font:500 1.65rem Georgia,serif; color:var(--maroon-dark); }
  .room-body p { color:var(--muted); line-height:1.7; min-height:74px; font-size:.92rem; }
  .room-bottom { display:flex; align-items:center; justify-content:space-between; gap:10px; border-top:1px solid var(--line); padding-top:17px; margin-top:15px; font-size:.83rem; font-weight:750; }
  .room-bottom a,.text-link { color:var(--maroon); font-weight:800; }
  .stay-timings { margin:32px auto 0; max-width:900px; padding:21px; border:1px solid var(--line); background:#fffdf9; display:grid; grid-template-columns:1fr 1fr; gap:14px; text-align:center; }
  .stay-timings div { display:grid; gap:6px; }
  .stay-timings span { color:var(--gold); font-size:.73rem; font-weight:800; letter-spacing:.12em; }
  .stay-timings strong { color:var(--maroon-dark); font:500 1.5rem Georgia,serif; }
  .stay-timings p { grid-column:1/-1; margin:2px 0 0; font-size:.84rem; color:var(--muted); }
  .welcome-grid { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:60px; }
  .welcome-photo img { width:100%; border-radius:5px; }
  .welcome-copy h2 { font-size:clamp(2rem,4vw,3rem); }
  .text-link { display:inline-flex; gap:12px; margin-top:12px; }
  .property-photos { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
  .property-photos img { aspect-ratio:4/3; width:100%; object-fit:cover; border-radius:5px; }
  .gallery-link { text-align:center; margin-top:22px; }
  @media(max-width:700px) { .property-photos {grid-template-columns:1fr 1fr} .property-photos img:last-child {grid-column:1/-1;aspect-ratio:16/9} }
  .cta { background:#f1e6d7; text-align:center; }
  .cta-inner { max-width:700px; }
  .cta h2 { color:var(--maroon-dark); font-size:clamp(2.2rem,4.5vw,3.5rem); margin:14px 0; }
  .cta p { color:var(--muted); line-height:1.8; margin:0 auto 24px; }
  @media(max-width:700px) {
    .hero-image { min-height:560px; background-position:58% center; }
    .hero-content { padding-top:65px; padding-bottom:65px; }
    .intro-grid,.welcome-grid { grid-template-columns:1fr; gap:20px; }
    .room-grid { grid-template-columns:1fr; max-width:500px; }
    .room-body p { min-height:0; }
    .welcome-photo { order:2; }
  }
</style>