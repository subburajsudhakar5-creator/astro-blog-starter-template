---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { hotel } from "../data/hotel";
---
<BaseLayout title="About us">
  <Header />
  <main>
    <section class="page-hero"><div class="container"><span class="eyebrow">GET TO KNOW US</span><h1 class="display">About {hotel.name}</h1><p>{hotel.town}, Tamil Nadu</p></div></section>
    <section class="section"><div class="container prose"><span class="eyebrow">A WARM WELCOME</span><h2 class="display">A comfortable place to stay in Ettayapuram.</h2><p>{hotel.description}</p><p>This page will be completed with the hotel's own story, service philosophy and verified property details once they are provided.</p><img src="/images/hotel-exterior-side.webp" alt="Exterior side view of Sree Venkatesh Residency" /></div></section>
  </main>
  <Footer />
</BaseLayout>
<style>
.page-hero{background:var(--cream);padding:78px 0;text-align:center}.page-hero h1{font-size:clamp(2.7rem,6vw,4.4rem);color:var(--maroon-dark);margin:15px 0}.page-hero p{color:var(--muted)}.prose{max-width:780px}.prose h2{font-size:clamp(2rem,4vw,3rem);color:var(--maroon-dark);margin:15px 0}.prose p{color:var(--muted);line-height:1.9}.prose img{margin-top:28px;width:100%;border-radius:6px}
</style>